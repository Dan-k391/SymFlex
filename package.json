{
  "name": "symflex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Notebook-style web emulator of Maple and FlexPDE for EP 2CD4",
  "scripts": {
    "setup": "node scripts/fetch_pyodide.mjs && node scripts/bundle_py.mjs && python scripts/build_examples.py",
    "dev": "node scripts/bundle_py.mjs && python scripts/build_examples.py && vite",
    "build": "node scripts/bundle_py.mjs && python scripts/build_examples.py && vite build",
    "preview": "vite preview",
    "test": "node src/ui/test/run_all.mjs",
    "test:ui": "node --test \"src/**/*.test.js\""
  },
  "devDependencies": {
    "vite": "8.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "katex": "0.19.1",
    "marked": "18.1.2",
    "plotly.js-dist-min": "4.2.0",
    "pyodide": "314.0.7"
  }
}
